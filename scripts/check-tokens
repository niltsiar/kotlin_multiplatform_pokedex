#!/usr/bin/env -S uv run python3
"""
Token Budget Checker
Uses tiktoken with cl100k_base encoding for accurate token counts
"""

import sys
import os

def check_tiktoken():
    try:
        import tiktoken
        return tiktoken
    except ImportError:
        print("❌ tiktoken not installed")
        print("Install with: pip install tiktoken")
        sys.exit(1)

def count_tokens(filepath, enc):
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            content = f.read()
            tokens = len(enc.encode(content))
            return tokens
    except FileNotFoundError:
        return None
    except Exception as e:
        print(f"⚠️  Error reading {filepath}: {e}")
        return None

def main():
    tiktoken = check_tiktoken()
    enc = tiktoken.get_encoding("cl100k_base")
    
    files = [
        "AGENTS.md",
        "llms.txt"
    ]
    
    print("Token Budget Analysis")
    print("====================")
    print("")
    
    total_tokens = 0
    over_budget = 0
    
    for f in files:
        tokens = count_tokens(f, enc)
        if tokens is None:
            print(f"⚠️  {f}: File not found")
            continue
            
        total_tokens += tokens
        status = "✅" if tokens < 2000 else "⚠️"
        if tokens >= 2000:
            over_budget += 1
        print(f"{status} {f}: {tokens} tokens")
    
    print("")
    print(f"Total: {total_tokens} tokens across {len(files)} files")
    
    if over_budget > 0:
        print(f"⚠️  {over_budget} file(s) over 2000 token budget")
    else:
        print("✅ All files within token budget")

if __name__ == "__main__":
    main()
